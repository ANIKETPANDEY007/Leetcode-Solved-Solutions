// M-1 --> Brute Force Approach . 
class Solution {
public:
    int longestSubarray(vector<int>& nums) {
        int n = nums.size() ;
        int maxCount = 0 ;
        bool useC = false ;

        for(int i=0;i<n;i++){
            bool chance = true ;
            int count = 0 ;
            for(int j=i;j<n;j++){
                if(nums[j]==1){
                    count++ ;
                    maxCount = max(count , maxCount) ;
                }
                else if(chance){
                    chance = false ;
                    useC = true ;
                }else break ;
            }
        }
        if(!useC) return maxCount-1 ; 
        return maxCount ;
    }
};

// M-2 --> Sliding Window Approach .

// Sliding Window Approach . 
class Solution {
public:
    int longestSubarray(vector<int>& nums) {
        int n = nums.size() ;
        int maxCount = 0 , zeroes = 0;
        int i=0 , j=0 ;
        for(int k=0 ; k<n ;k++){
            if(nums[k]==0) zeroes++ ;
        }
        if(zeroes==0) return n-1 ;
        while(i<n && nums[i]==0) i++ ;
        if(i==n) return 0 ;
        j = i ; zeroes = 0 ;
        while(j<n){
            if(nums[j]==1) j++ ;
            else{
                if(zeroes==0){
                    j++ ;
                    zeroes++ ;
                }else{
                    int len = j-i-1 ;
                    maxCount = max(len,maxCount) ;
                    j++ ;
                    while(i<n && nums[i]==1) i++ ;
                    i++ ;
                }
            }
        }
        if(zeroes==0) return j-i ;
        int len = j - i - 1 ;
        maxCount = max(maxCount,len) ;
        return maxCount ;
    }
};

