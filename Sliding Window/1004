// M-1 Brute Force . 
class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        int n = nums.size() ;
        int maxLen = 0 ;
        for(int i=0;i<n;i++){
            int count = 0 , countZ = 0;;
            for(int j=i;j<n;j++){
                if(nums[j]==1){
                    count++ ;
                }else{
                    if(countZ<k){
                        count++ ;
                        countZ++ ;
                    }else{
                        break ;
                    }
                }
            }
            maxLen = max(count , maxLen) ;
        }
        return maxLen ;

    }
};

// M-2 Sliding Window Approach . 

class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        int n = nums.size() ;
        int i = 0 , j = 0 , maxCount = 0 , nZ = 0; 

        while(j<n){
            if(nums[j]==0 ) nZ++ ;
            
            while(nZ>k){
                if(nums[i]==0) nZ-- ;
                i++ ;
            }
            int len  = j-i+1 ;
            maxCount = max(len,maxCount) ;
            j++ ;
        }
        return maxCount ;
    }
};