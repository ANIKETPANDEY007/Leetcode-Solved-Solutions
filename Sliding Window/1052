// Brute Force Approach . 

class Solution {
public:
    int maxSatisfied(vector<int>& nums, vector<int>& gr, int min) {
        int n = nums.size() ;
        int sum = 0 , gSum = 0 , maxGr = 0 ;

        for(int i=0;i<n;i++){
            if(gr[i]==0) sum += nums[i] ;
        }

        for(int i=0;i<min;i++){
            if(gr[i]==1) gSum += nums[i] ;
        }
        maxGr = max(maxGr,gSum) ;
        int i = 1 , j=min ;

        while(j<n){
            if(gr[j]==1) gSum += nums[j] ;
            if(gr[i-1]==1) gSum -= nums[i-1] ;
            maxGr = max(maxGr,gSum) ;
            i++ ; j++ ;
        }
        return maxGr+sum ;
    }
};

