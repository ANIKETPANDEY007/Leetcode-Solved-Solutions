// M-1
class Solution {
    public long subArrayRanges(int[] nums) {
        long sum = 0 ;
        int n = nums.length ;
        for(int i=0;i<n;i++){
            int largest = nums[i] ;
            int smallest = nums[i] ;
            for(int j=i+1;j<n;j++){
                largest = Math.max(nums[j],largest) ;
                smallest = Math.min(nums[j],smallest) ;
                sum = sum + (long)(largest-smallest) ;
            }
        }
        return sum ;
    }
}
// M-2
class Solution {
    public long minOfSubArray(int[] arr) {
        int n = arr.length ;
        int[] right = new int[n] ;
        int[] left = new int[n] ;
        Stack<Integer> st = new Stack<>() ;
        for(int i=0;i<n;i++){
            while(!st.isEmpty() && arr[st.peek()]>arr[i]){
                st.pop() ; 
            }
            if(st.isEmpty()) left[i] = i+1 ;
            else left[i] = i-st.peek() ;
            st.push(i) ;
        }
        while(!st.isEmpty()){
            st.pop() ;
        }
        for(int i=n-1;i>=0;i--){
            while(!st.isEmpty() && arr[st.peek()]>=arr[i]){
                st.pop() ;
            }
            if(st.isEmpty()) right[i] = n-i ;
            else right[i] = st.peek()-i ; 
            st.push(i) ;
        } 
       long contribution = 0 ;
        for(int i=0;i<n;i++){
            long val = (long)(right[i]*left[i]) ; 
            val = (val * arr[i]) ;
            contribution = (contribution + val);
        }
        return contribution ;
    }
    public long MaxOfSubArray(int[] arr) {
        int n = arr.length ;
        int[] right = new int[n] ;
        int[] left = new int[n] ;
        Stack<Integer> st = new Stack<>() ;
        for(int i=0;i<n;i++){
            while(!st.isEmpty() && arr[st.peek()]<arr[i]){
                st.pop() ; 
            }
            if(st.isEmpty()) left[i] = i+1 ;
            else left[i] = i-st.peek() ;
            st.push(i) ;
        }
        while(!st.isEmpty()){
            st.pop() ;
        }
        for(int i=n-1;i>=0;i--){
            while(!st.isEmpty() && arr[st.peek()]<=arr[i]){
                st.pop() ;
            }
            if(st.isEmpty()) right[i] = n-i ;
            else right[i] = st.peek()-i ; 
            st.push(i) ;
        } 
       long contribution = 0 ;
        for(int i=0;i<n;i++){
            long val = (long)(right[i]*left[i]) ; 
            val = (val * arr[i]) ;
            contribution = (contribution + val);
        }
        return contribution ;
    }

    public long subArrayRanges(int[] nums) {
        long sum = 0 ;
        int n = nums.length ;
        long largest = MaxOfSubArray(nums) ;
        long smallest = minOfSubArray(nums) ; 
        sum = largest - smallest ;
        return sum ;
    }
}