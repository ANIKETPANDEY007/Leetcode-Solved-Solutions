// Method-1
// Steps to get the middle of the linked list 
// 1.First I have to get the length of the linked list .
// 2.Then I will travel to the half of the linked list then return the middle .

class Solution {
    public ListNode middleNode(ListNode head) {
        ListNode temp = head ;
        int len = 0  ;
        while(temp!=null){
            temp = temp.next ;
            len++ ;
        }
        int mid = len/2 + 1 ;
        temp = head ;
        for(int i=0;i<mid-1;i++){
            temp = temp.next ;
        }
        return temp ;
    }
}

// Method-2 (Slow-Fast Aproach)
In this Aproach we create two nodes slow and fast and then we will travel through the LinkedList but the slow will go ahead by one step but the fast will go by two steps and when the fast will reach to null we will end the while loop.

class Solution {
    public ListNode middleNode(ListNode head) {
        ListNode slow = head ;
        ListNode fast = head ;
        while(fast!=null && fast.next!=null){
            slow = slow.next ;
            fast = fast.next.next ;
        }
        return slow ;
    }
}