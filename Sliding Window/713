// Brute Force Approach

class Solution {
public:
    int numSubarrayProductLessThanK(vector<int>& nums, int k) {
        int n = nums.size() ;
        int count=0 ;
        for(int i=0;i<n;i++){
            int mul = nums[i] ;
            if(mul<k) count++ ;
            else continue ;
            for(int j=i+1;j<n;j++){
                if(k>(mul*nums[j])){
                    mul *= nums[j] ;
                    count++ ;
                } 
                else break ;
            }
        }
        return count ;
    }
};

// Sliding Window Approach

class Solution {
public:
    int numSubarrayProductLessThanK(vector<int>& nums, int k) {

        if(k<=1) return 0 ;

        int n = nums.size() ;
        int count=0 ;
        int i=0 , j=0 ;
        long long prod = 1 ;

        while(i<n && j<n){
            prod *= nums[j] ;

            while(prod>=k){
                prod /= nums[i] ;
                i++ ;
            }
            count += (j-i+1) ;
            j++ ;
        }
        return count ;
    }
}; 