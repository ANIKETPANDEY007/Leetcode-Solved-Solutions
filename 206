Method-1(Iterative)
We created three nodes current , previous and next .

class Solution {
    public ListNode reverseList(ListNode head) {
        ListNode c = head ;
        ListNode n = null ;
        ListNode p = null;
        while(c!=null){
            n = c.next ;
            c.next = p ;
            p = c ;
            c = n ;
        }
        return p ;
    }
}

Method-2(Recursive)

class Solution {
    public ListNode reverseList(ListNode head) {
        // M-2 Reccursive 
        if(head==null || head.next == null) return head ;
        ListNode a = head.next ;
        ListNode newHead = reverseList(a) ;
        a.next = head ;
        head.next = null ;
        return newHead ;
    }
}