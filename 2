// Basically we have to reverse the list and then add it and then reverse the addition and store it in a new linkedlist .
class Solution {
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {
        ListNode dummy = new ListNode(-1) ;
        ListNode temp = dummy ;
        int t1 , t2 ,carry = 0 ;
        while(l1!=null || l2 !=null){
            t1 = 0 ; t2 = 0 ;
            if(l1!=null) t1 = l1.val ;
            if(l2!=null) t2 = l2.val ;
            int sum = t1 + t2 + carry ;
            ListNode node = new ListNode(sum%10) ;
            temp.next = node ;
            temp = temp.next ;
            if(sum>9) carry = 1 ;
            else carry = 0 ;
            if(l1!=null) l1 = l1.next ;
            if(l2!=null) l2 = l2.next ;
        }
        if(carry==1){
            ListNode n1 = new ListNode(1) ;
            temp.next = n1 ;
            temp = temp.next ;
        }
        return dummy.next ;
    }
}