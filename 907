class Solution {
    public int sumSubarrayMins(int[] arr) {
        int n = arr.length ;
        int[] right = new int[n] ;
        int[] left = new int[n] ;
        Stack<Integer> st = new Stack<>() ;
        for(int i=0;i<n;i++){
            while(!st.isEmpty() && arr[st.peek()]>arr[i]){
                st.pop() ; 
            }
            if(st.isEmpty()) left[i] = i+1 ;
            else left[i] = i-st.peek() ;
            st.push(i) ;
        }
        while(!st.isEmpty()){
            st.pop() ;
        }
        for(int i=n-1;i>=0;i--){
            while(!st.isEmpty() && arr[st.peek()]>=arr[i]){
                st.pop() ;
            }
            if(st.isEmpty()) right[i] = n-i ;
            else right[i] = st.peek()-i ; 
            st.push(i) ;
        } 
       long contribution = 0 ;
       long mod = 1000000007;
        for(int i=0;i<n;i++){
            long val = (long)(right[i]*left[i])%mod ; 
            val = (val * arr[i]) % mod ;
            contribution = (contribution + val)%mod ;
        }
        return (int)contribution ;
    }
}