// M-1 T.C -> O(N^2) S.C -> O(1) (Brute Force)
class Solution {
    public int[] twoSum(int[] arr, int target) {
        int[] ans = new int[2] ;
        int n = arr.length ;
        for(int i = 0;i<n;i++){
            for(int j=i+1;j<n;j++){
                if(arr[i]+arr[j]==target){
                    ans[0] = i ;
                    ans[1] = j ;
                }
            }
        }
        return ans ;
    }
}

// M-2 T.C -> O(N) S.C -> O(N) 

class Solution {
    public int[] twoSum(int[] nums, int target) {
        int[] ans = {-1,-1 } ;
        HashMap<Integer,Integer> map = new HashMap<>() ;
            for(int i=0;i<nums.length;i++){
                int rem = target - nums[i] ;
                if(map.containsKey(rem)){
                    ans[0] = i ;
                    ans[1] = map.get(rem) ;
                    break ;
                }else{
                    map.put(nums[i],i) ;
                }
            }
            return ans;
    }
}
