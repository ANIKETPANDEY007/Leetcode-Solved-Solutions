class Solution {
    public ListNode rotateRight(ListNode head, int k) {
        if(head==null || head.next==null) return head ;
        int len = 0 ;
        ListNode temp = head ;
        ListNode fast = head ;
        ListNode slow = head ;
        while(temp!=null){
            temp = temp.next ;
            len++ ;
        }
        k %= len ;  // Removing unneccessary rotation .
        if(k==0) return head ;
        for(int i=1;i<=k;i++){
            fast = fast.next ;
        }
        while(fast.next!=null){
            fast = fast.next ;
            slow = slow.next ;
            // By now we have find the point through which we have to rotate .
        }
        ListNode newHead = slow.next ;
        slow.next = null ;
        fast.next = head ;
        return newHead ;
    }
}